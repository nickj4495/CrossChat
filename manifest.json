{
  "manifest_version": 3,
  "name": "CrossChat",
  "version": "0.6.0",
  "description": "Multi-source CrossChat rooms with read-only Twitch live chat and local demo messaging.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "identity", "alarms"],
  "host_permissions": ["https://id.twitch.tv/*", "https://api.twitch.tv/*"],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_popup": "src/popup.html", "default_title": "CrossChat settings" },
  "content_scripts": [{
    "matches": ["https://www.twitch.tv/*", "https://www.youtube.com/*"],
    "js": ["src/mock-chat.js", "src/room-client.js", "src/twitch-emotes.js", "src/panel.js", "src/content.js"],
    "run_at": "document_idle"
  }]
}
