{
  "manifest_version": 3,
  "name": "CrossChat",
  "version": "0.3.0",
  "description": "A local mock prototype for unified Twitch and YouTube chat.",
  "permissions": ["storage"],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_popup": "src/popup.html", "default_title": "CrossChat settings" },
  "content_scripts": [{
    "matches": ["https://www.twitch.tv/*", "https://www.youtube.com/*"],
    "js": ["src/mock-chat.js", "src/room-client.js", "src/panel.js", "src/content.js"],
    "run_at": "document_idle"
  }]
}
