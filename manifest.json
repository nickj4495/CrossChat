{
  "manifest_version": 3,
  "name": "CrossChat",
  "version": "0.8.0",
  "description": "Read-only Twitch and YouTube chats in one CrossChat room, with local demo messaging.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "identity", "alarms"],
  "host_permissions": ["https://id.twitch.tv/*", "https://api.twitch.tv/*", "https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "202158828853-4jem87s8g4jd8162ao1dq8i11sthkv18.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/youtube.readonly"]
  },
  "background": { "service_worker": "src/background.js" },
  "action": { "default_popup": "src/popup.html", "default_title": "CrossChat settings" },
  "content_scripts": [{
    "matches": ["https://www.twitch.tv/*", "https://www.youtube.com/*"],
    "js": ["src/mock-chat.js", "src/view-model.js", "src/view-controls.js", "src/room-client.js", "src/twitch-emotes.js", "src/chat-scroll.js", "src/panel.js", "src/content.js"],
    "run_at": "document_idle"
  }]
}
