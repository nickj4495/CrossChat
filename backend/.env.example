# Copy to backend/.env (ignored by Git), then npm run start:configured.
# Copy the exact browser-specific origin from CrossChat Connections.
CROSSCHAT_EXTENSION_ORIGIN=moz-extension://REPLACE_WITH_YOUR_EXTENSION_UUID

# Firefox/Safari Google sign-in: Web application client, not Chrome Extension.
# Register http://127.0.0.1:47831/oauth/google/callback as an authorized redirect.
CROSSCHAT_GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
CROSSCHAT_GOOGLE_CLIENT_SECRET=REPLACE_WITH_WEB_CLIENT_SECRET

# Safari Twitch sign-in only (Firefox/Chrome use their native identity flow).
# Register http://127.0.0.1:47831/oauth/twitch/callback in the Twitch app.
# CROSSCHAT_TWITCH_CLIENT_ID=REPLACE_WITH_TWITCH_CLIENT_ID
# CROSSCHAT_TWITCH_CLIENT_SECRET=REPLACE_WITH_TWITCH_CLIENT_SECRET
